# =============================================================================
# GP-MEDICAL FRONTEND - ENVIRONMENT VARIABLES
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# For production (Railway example):
# NEXT_PUBLIC_API_URL=https://your-api.railway.app

# For production (Render example):
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# -----------------------------------------------------------------------------
# Stripe (Payment Gateway)
# -----------------------------------------------------------------------------
# Use test keys for development:
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# For production:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-live-publishable-key

# -----------------------------------------------------------------------------
# Analytics (Optional)
# -----------------------------------------------------------------------------
# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Mixpanel (Optional)
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_TELEMEDICINE=false
NEXT_PUBLIC_ENABLE_PAYMENTS=true

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# For Vercel deployment:
# 1. Go to your project settings in Vercel
# 2. Navigate to "Environment Variables"
# 3. Add these variables:
#    - NEXT_PUBLIC_API_URL: Your backend URL (e.g., https://your-api.railway.app)
#    - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: Your Stripe publishable key
#
# For Netlify deployment:
# 1. Go to Site settings > Build & deploy > Environment
# 2. Add the same variables as above
#
# Minimum required for deployment:
# - NEXT_PUBLIC_API_URL (your backend URL)
# - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (for payments)
#
# =============================================================================
