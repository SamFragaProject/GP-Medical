# =============================================================================
# GP-MEDICAL - ENVIRONMENT VARIABLES
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=GP-Medical
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# For local development:
DATABASE_URL=postgresql+asyncpg://gpmedical:gpmedical@localhost:5432/gpmedical

# For production (Supabase example):
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Redis (Optional - for caching and queues)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# For production (Upstash example):
# REDIS_URL=rediss://default:YOUR_PASSWORD@xxx.upstash.io:6379

# -----------------------------------------------------------------------------
# Security & Authentication (JWT)
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a strong secret key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS (Frontend URLs)
# -----------------------------------------------------------------------------
# For development:
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# For production (Vercel example):
# CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com

# Allowed Hosts (for production)
ALLOWED_HOSTS=*

# -----------------------------------------------------------------------------
# File Uploads
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,docx,xlsx,csv

# -----------------------------------------------------------------------------
# Email (SMTP) - Optional but recommended
# -----------------------------------------------------------------------------
# For Gmail example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@gp-medical.com
SMTP_FROM_NAME=GP-Medical

# For production (SendGrid example):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key

# -----------------------------------------------------------------------------
# WhatsApp/SMS (Twilio) - Optional
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# AI Configuration (OpenAI) - Required for AI features
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# Anthropic (Optional alternative)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# Payment Gateway (Stripe) - Required for payments
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# For production:
# STRIPE_SECRET_KEY=sk_live_your-stripe-live-secret-key
# STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-live-publishable-key

# Conekta (Optional - Mexico payment gateway)
CONEKTA_API_KEY=your-conekta-api-key

# -----------------------------------------------------------------------------
# CFDI 4.0 - Facturación México (PAC Provider)
# -----------------------------------------------------------------------------
PAC_PROVIDER=finkok
PAC_USERNAME=your-pac-username
PAC_PASSWORD=your-pac-password
PAC_ENDPOINT=https://demo-facturacion.finkok.com/servicios/soap

# For production (Finkok example):
# PAC_ENDPOINT=https://facturacion.finkok.com/servicios/soap

# -----------------------------------------------------------------------------
# Monitoring & Error Tracking (Sentry) - Optional but recommended
# -----------------------------------------------------------------------------
SENTRY_DSN=your-sentry-dsn-here

# For production:
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# -----------------------------------------------------------------------------
# Background Jobs (Celery) - Optional
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# For Railway/Render deployment:
# 1. Set ENVIRONMENT=production
# 2. Set DEBUG=false
# 3. Generate a strong SECRET_KEY
# 4. Update DATABASE_URL with your PostgreSQL connection string
# 5. Update CORS_ORIGINS with your frontend URL
# 6. Add your API keys (OpenAI, Stripe, etc.)
#
# For Vercel (Frontend):
# 1. Set NEXT_PUBLIC_API_URL to your backend URL
#    Example: https://your-api.railway.app
#
# Minimum required for basic deployment:
# - DATABASE_URL (PostgreSQL)
# - SECRET_KEY (generate with openssl rand -hex 32)
# - OPENAI_API_KEY (for AI features)
# - STRIPE_SECRET_KEY (for payments)
# - CORS_ORIGINS (your frontend URL)
#
# =============================================================================
