# Backend Configuration
DATABASE_URL=postgresql://gpmedical:gpmedical_dev_password@localhost:5432/gpmedical
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=development
DEBUG=True

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,docx,xlsx,csv

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@gp-medical.com
SMTP_FROM_NAME=GP-Medical

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# SMS
SMS_PROVIDER=twilio
SMS_API_KEY=your-sms-api-key

# AI Configuration
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# PAC (Facturación México)
PAC_PROVIDER=finkok
PAC_USERNAME=your-pac-username
PAC_PASSWORD=your-pac-password
PAC_ENDPOINT=https://demo-facturacion.finkok.com/servicios/soap

# Payment Gateway
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
CONEKTA_API_KEY=your-conekta-api-key

# Monitoring
SENTRY_DSN=your-sentry-dsn

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=GP-Medical
NEXT_PUBLIC_APP_URL=http://localhost:3000
